# Copy to .env. Generate your own secrets; never commit .env.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# Use a URL-safe password in both PostgreSQL settings.
POSTGRES_USER=hr
POSTGRES_PASSWORD=
POSTGRES_DB=hr_hiring
DATABASE_URL=postgresql+psycopg://hr:YOUR_URL_SAFE_PASSWORD@localhost:5432/hr_hiring
# SQLite-only fallback: DATABASE_URL=sqlite:///./hr_hiring.sqlite3
STORAGE_DIR=./storage/resumes
MAX_UPLOAD_BYTES=5242880
CANDIDATE_RETENTION_DAYS=365
AUTO_CREATE_TABLES=false

# Agent 1 uses GroqCloud through the existing OpenAI SDK. Keep the key private.
# Phase 1 works without a key. Evaluation returns 503; no fake provider fallback.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2

# PostgreSQL checkpoints automatically use DATABASE_URL unless overridden.
CHECKPOINT_DATABASE_URL=
CHECKPOINT_SQLITE_PATH=./storage/checkpoints.sqlite3
API_BASE_URL=http://127.0.0.1:8000

# Optional local seeding. An empty password generates a random one for new accounts.
DEMO_PASSWORD=
DEMO_EMAIL=recruiter@demo.test

# Optional live verification. Set only in your private local environment.
RUN_LIVE_GROQ=0
TEST_POSTGRES_URL=

# Phase 3 uses only free, local inference. Agent 1 settings above are preserved.
VOICE_PROVIDER=local
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=120
STT_PROVIDER=faster_whisper
WHISPER_MODEL=base
WHISPER_MODEL_PATH=storage/models/whisper-base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_PROVIDER=piper
TTS_VOICE=en_US-lessac-medium
PIPER_VOICE_PATH=storage/models/piper/en_US-lessac-medium.onnx
VOICE_THREADS=2
VOICE_MAX_AUDIO_BYTES=5242880
VOICE_MAX_AUDIO_SECONDS=90
SCREENING_MAX_FOLLOWUPS=2
SCREENING_DEFAULT_LANGUAGE=en
SCREENING_TOKEN_MINUTES=120
SCREENING_RETENTION_DAYS=30
SCREENING_RETENTION_AUTOMATIC=true
STREAMLIT_BASE_URL=http://127.0.0.1:8501
